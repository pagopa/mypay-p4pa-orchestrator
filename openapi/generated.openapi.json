{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "mypay-p4pa-orchestrator",
    "description" : "Api and Models",
    "version" : "0.0.1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "OrchestrateMigration",
    "description" : "Migration orchestration APIs"
  } ],
  "paths" : {
    "/orchestrate/migrate" : {
      "post" : {
        "tags" : [ "OrchestrateMigration" ],
        "summary" : "Start a migration orchestration",
        "description" : "Start an EXPORT, TRANSFER or COMPLETE migration action. EXPORT and COMPLETE actions require non-empty ipaCodes and fileTypesToInclude; all actions require orchestationMode. TRANSFER actions require migrationId for an existing completed migration and do not support REJECTS_ONLY mode. For REJECTS_ONLY EXPORT and COMPLETE actions, migrationId identifies the previous migration; rejected records are assembled by the orchestrator. FULL mode requires period for EXPORT and COMPLETE actions.",
        "operationId" : "orchestrateMigration",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MigrationRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Migration orchestration accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MigrationResponseDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid migration request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "404" : {
            "description" : "Requested resource not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "409" : {
            "description" : "Migration conflicts with an existing operation",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CycleMode" : {
        "type" : [ "string", "null" ],
        "enum" : [ "FULL", "DELTA", "REJECTS_ONLY" ]
      },
      "MigrationAction" : {
        "type" : [ "string", "null" ],
        "enum" : [ "EXPORT", "TRANSFER", "COMPLETE" ]
      },
      "MigrationExecutionStatus" : {
        "type" : [ "string", "null" ],
        "enum" : [ "RUNNING", "COMPLETED", "FAILED", "WARNING" ]
      },
      "MigrationResponseDto" : {
        "type" : "object",
        "properties" : {
          "migrationId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "action" : {
            "$ref" : "#/components/schemas/MigrationAction"
          },
          "status" : {
            "$ref" : "#/components/schemas/MigrationExecutionStatus"
          },
          "orchestationMode" : {
            "$ref" : "#/components/schemas/CycleMode"
          },
          "ipaCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "createdAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "uploadIds" : {
            "type" : "array",
            "description" : "Upload identifiers, populated only for TRANSFER actions",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "CategoryEnum" : {
        "type" : "string",
        "enum" : [ "NOT_FOUND", "BAD_REQUEST", "GENERIC_ERROR", "TOO_MANY_REQUESTS", "CONFLICT", "FORBIDDEN", "UNAUTHORIZED" ]
      },
      "ErrorDTO" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "$ref" : "#/components/schemas/CategoryEnum"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "category", "code", "message" ]
      },
      "MigrationFileType" : {
        "type" : "string",
        "enum" : [ "ORGANIZATIONS", "ORG_SIL_SERVICES", "DEBT_POSITIONS_TYPE", "DEBT_POSITIONS_TYPE_ORG", "DEBT_POSITIONS_TYPE_ORG_OPERATORS", "DEBT_POSITIONS", "DEBT_POSITIONS_PAID", "PAYMENT_NOTIFICATION", "PAYMENTS_REPORTING", "TREASURY_CSV_COMPLETE", "ASSESSMENTS", "ASSESSMENTS_REGISTRY" ]
      },
      "MigrationRequestDto" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "$ref" : "#/components/schemas/MigrationAction"
          },
          "ipaCodes" : {
            "type" : "array",
            "description" : "Required and non-empty for EXPORT and COMPLETE actions",
            "items" : {
              "type" : "string"
            }
          },
          "orchestationMode" : {
            "$ref" : "#/components/schemas/CycleMode",
            "description" : "Required for all migration actions; REJECTS_ONLY is not supported for TRANSFER"
          },
          "fileTypesToInclude" : {
            "type" : "array",
            "description" : "Required and non-empty for EXPORT and COMPLETE actions",
            "items" : {
              "$ref" : "#/components/schemas/MigrationFileType"
            }
          },
          "period" : {
            "$ref" : "#/components/schemas/PeriodDto",
            "description" : "Required when orchestationMode is FULL for EXPORT and COMPLETE actions"
          },
          "migrationId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid",
            "description" : "For TRANSFER, must identify an existing completed migration; for REJECTS_ONLY EXPORT and COMPLETE, identifies the previous migration"
          },
          "logicalKey" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "action", "orchestationMode" ]
      },
      "PeriodDto" : {
        "type" : "object",
        "properties" : {
          "fromDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          },
          "toDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          }
        }
      }
    }
  }
}