{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "mypay-p4pa-orchestrator",
    "description" : "Api and Models",
    "version" : "0.0.1"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "tags" : [ {
    "name" : "OrchestrateMigration",
    "description" : "Migration orchestration APIs"
  } ],
  "paths" : {
    "/orchestrate/migrate" : {
      "post" : {
        "tags" : [ "OrchestrateMigration" ],
        "summary" : "Start a migration orchestration",
        "description" : "Start an EXPORT, TRANSFER or COMPLETE migration action. EXPORT and COMPLETE actions require non-empty ipaCodes and fileTypesToInclude; all actions require orchestrationMode. TRANSFER actions require migrationId for an existing completed EXPORT migration and do not support REJECTS_ONLY mode. For REJECTS_ONLY EXPORT and COMPLETE actions, migrationId identifies the previous migration; rejected records are assembled by the orchestrator. FULL mode requires period for EXPORT and COMPLETE actions.",
        "operationId" : "orchestrateMigration",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MigrationRequestDto"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Migration orchestration accepted",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MigrationResponseDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid migration request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "404" : {
            "description" : "Requested resource not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          },
          "409" : {
            "description" : "Migration conflicts with an existing operation",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          }
        }
      }
    },
    "/orchestrate/migrate/{migration_id}" : {
      "get" : {
        "tags" : [ "OrchestrateMigration" ],
        "summary" : "Get migration orchestration status",
        "description" : "Returns the single migration status and persisted file execution details. The status is not split into separate export and transfer statuses.",
        "operationId" : "getMigrationStatus",
        "parameters" : [ {
          "name" : "migration_id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Migration status",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MigrationStatusDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Migration not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          }
        }
      }
    },
    "/orchestrate/migrate/{migration_id}/transfer/file-status/{fileType}" : {
      "get" : {
        "tags" : [ "OrchestrateMigration" ],
        "summary" : "Get persisted transfer status for a file type",
        "description" : "Returns upload fields and accepted/rejected row totals aggregated from migration file execution detail records.",
        "operationId" : "getTransferFileStatus",
        "parameters" : [ {
          "name" : "migration_id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "fileType",
          "in" : "path",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/MigrationFileType"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Transfer file status",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TransferFileStatusDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Migration or file execution not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          }
        }
      }
    },
    "/orchestrate/migrate/{migration_id}/export/file-status/{fileType}" : {
      "get" : {
        "tags" : [ "OrchestrateMigration" ],
        "summary" : "Get persisted export status for a file type",
        "description" : "Returns extraction fields and row totals aggregated from migration file execution detail records.",
        "operationId" : "getExportFileStatus",
        "parameters" : [ {
          "name" : "migration_id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "fileType",
          "in" : "path",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/MigrationFileType"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Export file status",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ExportFileStatusDto"
                }
              }
            }
          },
          "404" : {
            "description" : "Migration or file execution not found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorDTO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "MigrationAction" : {
        "type" : "string",
        "enum" : [ "EXPORT", "TRANSFER", "COMPLETE" ]
      },
      "MigrationExecutionStatus" : {
        "type" : "string",
        "enum" : [ "RUNNING", "COMPLETED", "FAILED", "WARNING" ]
      },
      "MigrationResponseDto" : {
        "type" : "object",
        "properties" : {
          "migrationId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          },
          "action" : {
            "$ref" : "#/components/schemas/MigrationAction"
          },
          "status" : {
            "$ref" : "#/components/schemas/MigrationExecutionStatus"
          },
          "orchestrationMode" : {
            "$ref" : "#/components/schemas/OrchestrationMode"
          },
          "ipaCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "createdAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "uploadIds" : {
            "type" : "array",
            "description" : "Upload identifiers, populated only for TRANSFER actions",
            "items" : {
              "type" : "string"
            }
          }
        }
      },
      "OrchestrationMode" : {
        "type" : "string",
        "enum" : [ "FULL", "DELTA", "REJECTS_ONLY" ]
      },
      "CategoryEnum" : {
        "type" : "string",
        "enum" : [ "NOT_FOUND", "BAD_REQUEST", "GENERIC_ERROR", "TOO_MANY_REQUESTS", "CONFLICT", "FORBIDDEN", "UNAUTHORIZED" ]
      },
      "ErrorDTO" : {
        "type" : "object",
        "properties" : {
          "category" : {
            "$ref" : "#/components/schemas/CategoryEnum"
          },
          "code" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "category", "code", "message" ]
      },
      "MigrationFileType" : {
        "type" : "string",
        "enum" : [ "ORGANIZATIONS", "ORG_SIL_SERVICES", "DEBT_POSITIONS_TYPE", "DEBT_POSITIONS_TYPE_ORG", "DEBT_POSITIONS_TYPE_ORG_OPERATORS", "DEBT_POSITIONS", "DEBT_POSITIONS_PAID", "PAYMENT_NOTIFICATION", "PAYMENTS_REPORTING", "TREASURY_CSV_COMPLETE", "ASSESSMENTS", "ASSESSMENTS_REGISTRY" ]
      },
      "MigrationRequestDto" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "$ref" : "#/components/schemas/MigrationAction"
          },
          "ipaCodes" : {
            "type" : "array",
            "description" : "Required and non-empty for EXPORT and COMPLETE actions",
            "items" : {
              "type" : "string"
            }
          },
          "orchestrationMode" : {
            "$ref" : "#/components/schemas/OrchestrationMode",
            "description" : "Required for all migration actions; REJECTS_ONLY is not supported for TRANSFER"
          },
          "fileTypesToInclude" : {
            "type" : "array",
            "description" : "Required and non-empty for EXPORT and COMPLETE actions",
            "items" : {
              "$ref" : "#/components/schemas/MigrationFileType"
            }
          },
          "period" : {
            "$ref" : "#/components/schemas/PeriodDto",
            "description" : "Required when orchestrationMode is FULL for EXPORT and COMPLETE actions"
          },
          "migrationId" : {
            "type" : [ "string", "null" ],
            "format" : "uuid",
            "description" : "For TRANSFER, must identify an existing completed EXPORT migration; for REJECTS_ONLY EXPORT and COMPLETE, identifies the previous migration"
          },
          "logicalKey" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "action", "orchestrationMode" ]
      },
      "PeriodDto" : {
        "type" : "object",
        "properties" : {
          "fromDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          },
          "toDate" : {
            "type" : [ "string", "null" ],
            "format" : "date"
          }
        }
      },
      "ExportFileStatusDto" : {
        "type" : "object",
        "description" : "Persisted extraction fields and totals from associated file execution details.",
        "properties" : {
          "fileType" : {
            "$ref" : "#/components/schemas/MigrationFileType"
          },
          "status" : {
            "$ref" : "#/components/schemas/MigrationFileExecutionStatus",
            "description" : "Current shared file execution status"
          },
          "extractionId" : {
            "type" : [ "string", "null" ]
          },
          "filePath" : {
            "type" : [ "string", "null" ]
          },
          "recordCount" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Sum of numTotalRows over this file execution's detail records"
          },
          "errorCode" : {
            "type" : [ "string", "null" ]
          },
          "errorMsg" : {
            "type" : [ "string", "null" ]
          },
          "extractionStartedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "extractedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          }
        },
        "required" : [ "fileType", "status" ]
      },
      "MigrationExportPhaseDto" : {
        "type" : "object",
        "description" : "Export file details; the phase status mirrors the single migration status.",
        "properties" : {
          "status" : {
            "$ref" : "#/components/schemas/MigrationExecutionStatus"
          },
          "files" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ExportFileStatusDto"
            }
          }
        },
        "required" : [ "files", "status" ]
      },
      "MigrationFileExecutionStatus" : {
        "type" : "string",
        "enum" : [ "PENDING", "EXPORTING", "EXPORTED", "TRANSFERING", "WAITING_PU", "COMPLETED", "WARNING", "FAILED" ]
      },
      "MigrationStatusDto" : {
        "type" : "object",
        "properties" : {
          "migrationId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "action" : {
            "$ref" : "#/components/schemas/MigrationAction"
          },
          "status" : {
            "$ref" : "#/components/schemas/MigrationExecutionStatus"
          },
          "orchestrationMode" : {
            "$ref" : "#/components/schemas/OrchestrationMode"
          },
          "ipaCodes" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "createdAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "updatedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "errorCode" : {
            "type" : [ "string", "null" ]
          },
          "errorMsg" : {
            "type" : [ "string", "null" ]
          },
          "exportPhase" : {
            "$ref" : "#/components/schemas/MigrationExportPhaseDto"
          },
          "transferPhase" : {
            "$ref" : "#/components/schemas/MigrationTransferPhaseDto"
          }
        },
        "required" : [ "action", "exportPhase", "ipaCodes", "migrationId", "orchestrationMode", "status", "transferPhase" ]
      },
      "MigrationTransferPhaseDto" : {
        "type" : "object",
        "description" : "Transfer file details; the phase status mirrors the single migration status.",
        "properties" : {
          "status" : {
            "$ref" : "#/components/schemas/MigrationExecutionStatus"
          },
          "files" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/TransferFileStatusDto"
            }
          }
        },
        "required" : [ "files", "status" ]
      },
      "TransferFileStatusDto" : {
        "type" : "object",
        "description" : "Persisted upload fields and accepted/rejected totals from associated file execution details.",
        "properties" : {
          "fileType" : {
            "$ref" : "#/components/schemas/MigrationFileType"
          },
          "status" : {
            "$ref" : "#/components/schemas/MigrationFileExecutionStatus",
            "description" : "Current shared file execution status"
          },
          "uploadId" : {
            "type" : [ "integer", "null" ],
            "format" : "int64"
          },
          "uploadStatus" : {
            "type" : [ "string", "null" ]
          },
          "recordsAccepted" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Sum of numCorrectlyImportedRows over this file execution's detail records"
          },
          "recordsRejected" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Sum of numTotalRows minus numCorrectlyImportedRows over detail records"
          },
          "errorCode" : {
            "type" : [ "string", "null" ]
          },
          "errorMsg" : {
            "type" : [ "string", "null" ]
          },
          "uploadedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "evidenceCollectedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time",
            "description" : "Latest updateDate among terminal migration file execution details (COMPLETED, PARTIAL, FAILED)"
          }
        },
        "required" : [ "fileType", "status" ]
      }
    }
  }
}